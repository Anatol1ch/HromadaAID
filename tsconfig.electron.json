{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "esModuleInterop": true
  },
  "include": ["electron/main.ts", "electron/preload.cts", "electron/*.test.ts", "shared/**/*.ts"]
}
