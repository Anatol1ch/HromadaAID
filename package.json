{
  "name": "hromada-aid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Візуальний прототип обліку матеріальної допомоги громади",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && tsc -p tsconfig.electron.json && node electron/copy-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^44.7.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wait-on": "^8.0.4"
  },
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "local.hromadaaid",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/hromadaaid.ico",
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "assets/hromadaaid.ico",
      "uninstallerIcon": "assets/hromadaaid.ico",
      "installerHeaderIcon": "assets/hromadaaid.ico",
      "shortcutName": "HromadaAID",
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "hromadaaid.ico",
          "hromadaaid.png",
          "hromadaaid.svg"
        ]
      }
    ]
  }
}
