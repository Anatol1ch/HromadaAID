{
  "name": "hromada-aid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Візуальний прототип обліку матеріальної допомоги громади",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && node scripts/clean-electron-build.mjs && tsc -p tsconfig.electron.json && node electron/copy-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server:dev": "pnpm server:build && concurrently -k \"pnpm exec tsc -p server/tsconfig.json --watch\" \"node --watch dist-server/server/src/index.js\"",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node dist-server/server/src/index.js",
    "server:start:installed": "node dist-server/server/src/installed.js",
    "server:initialize": "pnpm server:build && node dist-server/server/src/initialize.js",
    "server:create-admin": "pnpm server:build && node dist-server/server/src/create-admin.js",
    "server:backup-decrypt": "pnpm server:build && node dist-server/server/src/backup-decrypt.js",
    "server:backup-key-setup": "pnpm server:build && node dist-server/server/src/backup-key-setup.js",
    "server:test-backups": "pnpm server:build && node --test dist-server/server/src/backup-distribution.test.js dist-server/server/src/backup-restore.test.js dist-server/server/src/backup-restore-cli.test.js",
    "server:backup-restore": "pnpm server:build && node dist-server/server/src/backup-restore-cli.js",
    "server:test-installer": "pnpm server:build && node --test dist-server/server/src/installer-initialization.test.js",
    "windows:package": "pnpm build && pnpm server:build && node scripts/prepare-server-package.mjs && node scripts/deploy-server-package.mjs && node node_modules/electron-builder/cli.js --win --x64 --dir && node scripts/package-windows.mjs",
    "windows:installer": "pnpm run windows:package && node scripts/build-windows-installer.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "argon2": "0.45.1",
    "concurrently": "^9.2.1",
    "electron": "^44.7.1",
    "electron-builder": "26.18.0",
    "fastify": "5.12.7",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wait-on": "^8.0.4"
  },
  "main": "dist-electron/electron/main.js",
  "productName": "HromadaAID",
  "build": {
    "appId": "local.hromadaaid",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/hromadaaid.ico",
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "assets/hromadaaid.ico",
      "uninstallerIcon": "assets/hromadaaid.ico",
      "installerHeaderIcon": "assets/hromadaaid.ico",
      "shortcutName": "HromadaAID",
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "hromadaaid.ico",
          "hromadaaid.png",
          "hromadaaid.svg"
        ]
      }
    ]
  }
}
