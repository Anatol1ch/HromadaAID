# Dependencies and generated application bundles
node_modules/
dist/
dist-electron/
dist-server/
dist-server-manager/
dist-package/
server/dist/
release/
.vite/
.cache/

# Local environment and credentials
.env
.env.*
*.env
!.env.example
!.env.template
# Private key stores and local key files. Keep the committed self-signed
# TLS test fixtures explicit; they are not production credentials.
*.pem
*.key
*.p8
*.p12
*.pfx
*.ppk
*.jks
*.keystore
!server/test-fixtures/tls-test-cert.pem
!server/test-fixtures/tls-test-key.pem
!server/test-fixtures/tls-other-test-key.pem

# Local SQLite data, journals and backups
*.sqlite
*.sqlite3
*.db
*.db3
*.sqlite-wal
*.sqlite-shm
*-wal
*-shm
*.bak
*.backup
*.sqlite.backup
*.sqlite.partial
*.hraid
*.hraid.partial
*.hraid.*.partial
*.dpapi*
.hromadaaid-*-sync.json*

# Runtime logs and process artefacts
*.log
*.err
*.out
*.pid
*.dmp
*.mdmp
*.core
core
core.*
*.crash
*.stackdump
*.dump

# Local generated documents and exports
generated-documents/
generated-documents-temp/
exports/
documents/
private/
*.generated.pdf
*.generated.xlsx

# Only the owner-approved Client document templates belong in the repository.
# Keep every other local document under reference/ ignored.
reference/*
!reference/Список.xlsx
!reference/Зведений список.xlsx
!reference/ПриватБанк.xlsx

# Test and tool artefacts
__pycache__/
*.py[cod]
.electron-smoke.*
.electron-version.*
.hromada-vite-qa.*

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vs/

# Isolated API development databases
server/.data/
backup-identity/
client-backups/
restore-staging/
